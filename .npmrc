# Project npm settings (architecture.md section 2.2; security design review T10-F18).
# No auth token and no alternate registry may be added to this file.
# legacy-peer-deps=true: peer dependencies are never installed implicitly; every required peer is
# declared explicitly at an exact version (npm 10.9 also fails to resolve the optional peer cycles
# of vite and vitest without it).
registry=https://registry.npmjs.org/
save-exact=true
engine-strict=true
ignore-scripts=true
legacy-peer-deps=true
fund=false
