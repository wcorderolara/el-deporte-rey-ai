# Copy to .env.local (git-ignored; create it with owner-only permissions, mode 0600) and fill in only what you need.
# See docs/local-setup.md. Never commit real values, never print them, never paste them into a chat or an issue.

# Sports-data provider token, required only when the LIVE_DATA configuration is enabled
# (EDR_CONFIG=config/live.config.json). Leave empty for DEMO_DATA and MANUAL_DATA.
FOOTBALL_DATA_API_TOKEN=

# API key of an OpenAI-compatible AI endpoint, required only when the configured endpoint needs one.
EDR_AI_API_KEY=
